<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="FreeScreen" Width="1040" Height="760" MinWidth="940" MinHeight="720" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResizeWithGrip" Background="#111517" Foreground="#F0F3EF" FontFamily="Segoe UI" FontSize="14">
  <Window.Resources>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="9"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="#181E20"><Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" ViewportSize="{TemplateBinding ViewportSize}" Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#53665C" CornerRadius="4" Margin="3,0,0,0"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter>
    </Style>
    <SolidColorBrush x:Key="Muted" Color="#98A6A6"/>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#DCE4DF"/><Setter Property="Background" Value="#252E30"/><Setter Property="Padding" Value="18,12"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8" BorderThickness="1" BorderBrush="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.82"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.65"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#BBF6D2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#8E9F9C"/><Setter TargetName="Surface" Property="Background" Value="#252E30"/><Setter Property="Cursor" Value="Arrow"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="16,12"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
  </Window.Resources>
  <Border BorderBrush="#323C3D" BorderThickness="1">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid x:Name="TitleBar" Background="#111517">
      <TextBlock Text="FREESCREEN  /  AIRPLAY FOR WINDOWS" Foreground="#6F8180" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" Margin="24,0"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,8,0"><Button x:Name="Minimize" Content="─" Width="42" Padding="0" Background="Transparent" ToolTip="Minimize" AutomationProperties.Name="Minimize window"/><Button x:Name="Close" Content="✕" Width="42" Padding="0" Background="Transparent" ToolTip="Quit FreeScreen" AutomationProperties.Name="Quit FreeScreen"/></StackPanel>
    </Grid>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="#111517" BorderBrush="#263031" BorderThickness="0,0,1,0">
        <Grid Margin="18,18,18,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel Margin="8,0,0,44">
            <Border Width="44" Height="44" Background="#B8F3CC" CornerRadius="12" HorizontalAlignment="Left"><Viewbox Margin="9"><Canvas Width="28" Height="28"><Path Stroke="#142720" StrokeThickness="2.2" StrokeLineJoin="Round" Data="M 3,16 L 3,4 L 25,4 L 25,20 L 15,20 M 13,24 L 20,24 M 17,20 L 17,24 M 3,21 L 3,25 M 3,15 A 10,10 0 0 1 13,25 M 3,20 A 5,5 0 0 1 8,25"/></Canvas></Viewbox></Border>
            <TextBlock Text="FreeScreen" FontSize="23" FontWeight="SemiBold" Margin="0,14,0,4"/><TextBlock Text="Small screen. More space." FontSize="10" Foreground="{StaticResource Muted}"/>
          </StackPanel>
          <StackPanel Grid.Row="1"><Button x:Name="NavHome" Style="{StaticResource Nav}" Background="#23342D" Foreground="#B8F3CC" Content="Mirror"/><Button x:Name="NavHelp" Style="{StaticResource Nav}" Content="Connection help"/></StackPanel>
          <StackPanel Grid.Row="2" Margin="8,0"><TextBlock Text="FREE. ALWAYS." Foreground="#B8F3CC" FontWeight="SemiBold" FontSize="10"/><TextBlock Text="Open Source · GPLv3" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,8,0,5"/><TextBlock Text="Version 0.2.0" Foreground="#667A77" FontSize="11"/></StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Column="1" Background="#181E20" Margin="0">
        <Grid x:Name="HomePage" Margin="36,22,36,24">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid Margin="0,0,0,26"><StackPanel><TextBlock Text="YOUR SCREEN, SHARED." Foreground="#9DB1A7" FontSize="10" FontWeight="SemiBold"/><TextBlock Text="From your iPhone. To your PC." FontSize="29" FontWeight="SemiBold" Margin="0,8,0,8"/><TextBlock Text="Mirror wirelessly. No app needed on your iPhone." Foreground="{StaticResource Muted}" FontSize="14"/></StackPanel></Grid>
          <Border Grid.Row="1" Background="#212C2B" BorderBrush="#354B40" BorderThickness="1" CornerRadius="16" Padding="25">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <StackPanel Orientation="Horizontal"><Ellipse x:Name="StatusDot" Fill="#B8F3CC" Width="7" Height="7" Margin="0,0,8,0"/><TextBlock x:Name="StatusBadge" Text="STARTING RECEIVER" Foreground="#B8F3CC" FontSize="10" FontWeight="SemiBold"/></StackPanel>
              <Grid Grid.Row="1" Margin="0,18,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="132"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,14,0"><TextBlock x:Name="StatusTitle" Text="Just a moment …" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="StatusDescription" Text="FreeScreen is getting ready to receive." Foreground="#BAC8C1" TextWrapping="Wrap" LineHeight="21" Margin="0,10,0,0" MinHeight="44"/><StackPanel Orientation="Horizontal" Margin="0,15,0,0"><TextBlock Text="Select on your iPhone:  " Foreground="#91A59B" FontSize="12"/><TextBlock Text="FreeScreen" FontWeight="SemiBold" Foreground="#E6F8EC" FontSize="12"/></StackPanel></StackPanel>
                <Viewbox Grid.Column="1" Width="126" VerticalAlignment="Center"><Canvas Width="132" Height="100"><Rectangle Width="100" Height="65" RadiusX="8" RadiusY="8" Canvas.Left="28" Canvas.Top="7" Stroke="#60816E" StrokeThickness="2" Fill="#1B2422"/><Path Data="M 68,72 L 68,83 M 89,72 L 89,83 M 59,84 L 98,84" Stroke="#60816E" StrokeThickness="2"/><Rectangle Width="34" Height="62" Canvas.Top="35" Canvas.Left="4" RadiusX="7" RadiusY="7" Fill="#B8F3CC"/><Rectangle Width="14" Height="3" RadiusX="1.5" RadiusY="1.5" Canvas.Left="14" Canvas.Top="39" Fill="#243A2C"/><Path Data="M 17,64 L 24,57 L 24,62 L 58,62 L 58,41 L 75,41" Stroke="#B8F3CC" StrokeThickness="2" StrokeDashArray="2 3"/><Path Data="M 72,37 L 77,41 L 72,45" Stroke="#B8F3CC" StrokeThickness="2"/></Canvas></Viewbox>
              </Grid>
              <StackPanel Grid.Row="2" Orientation="Horizontal"><Button x:Name="Primary" Content="How to connect" Background="#B8F3CC" Foreground="#16251C" FontWeight="SemiBold" MinWidth="166"/><Button x:Name="Toggle" Content="Stop receiver" Background="Transparent" Foreground="#B6C8BE" Margin="10,0,0,0"/></StackPanel>
            </Grid>
          </Border>
          <StackPanel Grid.Row="2" Margin="0,25,0,0">
            <Grid><TextBlock Text="A bigger screen in three simple steps" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="NO CABLE NEEDED" HorizontalAlignment="Right" Foreground="#758A82" FontSize="9" VerticalAlignment="Center"/></Grid>
            <UniformGrid Columns="3" Margin="0,18,0,0">
              <StackPanel Margin="0,0,18,0"><TextBlock Text="01 / CONNECT" FontSize="10" FontWeight="SemiBold" Foreground="#B8F3CC"/><TextBlock Text="Use the same Wi-Fi" FontWeight="SemiBold" Margin="0,10,0,6"/><TextBlock Text="Connect your iPhone and PC to the same network." Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12" LineHeight="18"/></StackPanel>
              <StackPanel Margin="0,0,18,0"><TextBlock Text="02 / MIRROR" FontSize="10" FontWeight="SemiBold" Foreground="#B8F3CC"/><TextBlock Text="Open Control Center" FontWeight="SemiBold" Margin="0,10,0,6"/><TextBlock Text="Tap Screen Mirroring, the icon with two overlapping rectangles." Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12" LineHeight="18"/></StackPanel>
              <StackPanel><TextBlock Text="03 / ENJOY" FontSize="10" FontWeight="SemiBold" Foreground="#B8F3CC"/><TextBlock Text="Select FreeScreen" FontWeight="SemiBold" Margin="0,10,0,6"/><TextBlock Text="Your screen opens in its own window. Fullscreen: Alt + Enter." Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12" LineHeight="18"/></StackPanel>
            </UniformGrid>
          </StackPanel>
          <Grid Grid.Row="3" Margin="0,20,0,0"><TextBlock Text="Local Wi-Fi. No account. No time limit." Foreground="#7F948A" FontSize="11"/><TextBlock x:Name="NetworkLabel" Text="Checking network …" HorizontalAlignment="Right" Foreground="#9CB4A6" FontSize="11"/></Grid>
        </Grid>
        <Grid x:Name="HelpPage" Visibility="Collapsed" Margin="36,22,36,24">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel Margin="0,0,0,25"><TextBlock Text="LET’S GET YOU CONNECTED." FontSize="10" Foreground="#9DB1A7" FontWeight="SemiBold"/><TextBlock Text="A clear path to your screen." FontSize="29" FontWeight="SemiBold" Margin="0,8,0,8"/><TextBlock Text="Your screen appears in a separate FreeScreen window." Foreground="{StaticResource Muted}"/></StackPanel>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
            <Border Background="#222C2D" CornerRadius="12" Padding="22" Margin="0,0,0,14"><StackPanel><TextBlock Text="Can’t find FreeScreen on your iPhone?" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="Connect both devices to the same Wi-Fi. Guest networks and VPNs can keep devices apart. Allow FreeScreen to receive connections on your local network." Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="21" Margin="0,10,0,16"/><Button x:Name="Firewall" Content="Allow network access" HorizontalAlignment="Left" Background="#B8F3CC" Foreground="#16251C" FontWeight="SemiBold"/><TextBlock x:Name="FirewallStatus" Text="Windows will ask for administrator permission." Foreground="#9DB1A7" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel></Border>
            <Border Background="#222C2D" CornerRadius="12" Padding="22" Margin="0,0,0,14"><StackPanel><TextBlock Text="Audio works, but no picture?" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="Use “Screen Mirroring” in Control Center (two overlapping rectangles). The media output picker can send audio only. When the status says “Screen connected”, use “Open screen window” to bring the video to the front." Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="21" Margin="0,10,0,0"/></StackPanel></Border>
            <Border Background="#222C2D" CornerRadius="12" Padding="22"><StackPanel><TextBlock Text="Reconnect" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="Stop mirroring on your iPhone, then select FreeScreen again. Protected streaming content may appear black." Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="21" Margin="0,10,0,0"/></StackPanel></Border>
          </StackPanel></ScrollViewer>
          <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,16,0,0"><Button x:Name="Back" Content="Back to mirroring"/><Button x:Name="Logs" Content="Open local diagnostics" Background="Transparent" Foreground="#9DB1A7" Margin="8,0,0,0" ToolTip="Logs may contain device names and network addresses. Review them before sharing."/></StackPanel>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
  </Border>
</Window>
